rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /catalog_metadata/{countryCode} {
      allow read: if true;
      allow write: if false;
    }

    match /countries/{countryCode}/products/{productId} {
      allow read: if resource.data.active == true;
      allow write: if false;
    }

    // NUEVO: sincronización familiar. Solo la cuenta del hogar (Firebase
    // Authentication, correo y contraseña) puede leer y escribir sus datos.
    match /households/{householdId}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == householdId;
    }
  }
}
